# --- Object storage (MinIO) ---------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# If this MinIO tag can't be pulled, use any other MinIO (or S3-compatible) image.
# MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# --- Dagster metadata DB ----------------------------------------------------
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster
POSTGRES_DB=dagster

# --- Spark --------------------------------------------------------------------
SPARK_MASTER=spark://spark-master:7077
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=1536m
SPARK_EXECUTOR_CORES=2
SPARK_CORES_MAX=2
SPARK_DRIVER_MEMORY=1g

# --- Data period: monthly partitions [start, end) -> Q1 2023 ------------------
PIPELINE_START_MONTH=2023-01
PIPELINE_END_MONTH=2023-04

# --- Chicago open data (SODA API) ---------------------------------------------
# Optional but recommended (higher rate limits): https://data.cityofchicago.org/profile/edit/developer_settings
SODA_APP_TOKEN=
SODA_PAGE_SIZE=50000
